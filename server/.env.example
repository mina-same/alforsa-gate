NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://localhost:27017/alforsa-gate

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173

# ── WhatsApp (OpenWA) ──────────────────────────────────
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_key
OPENWA_SESSION_ID=your_openwa_session_id
OPENWA_SESSION_NAME=alforsa
